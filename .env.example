# Copy to .env. Providers: anthropic | moonshot. Judge and skeptic MUST use different providers.
LLM_EXTRACT_PROVIDER=anthropic
LLM_EXTRACT_MODEL=
LLM_JUDGE_PROVIDER=anthropic
LLM_JUDGE_MODEL=
LLM_SKEPTIC_PROVIDER=moonshot
LLM_SKEPTIC_MODEL=

ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Polite-pool contact for Crossref/OpenAlex; required by Unpaywall
CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
# Required by OpenAlex since Feb 2026; added to every api.openalex.org request by core.http
OPENALEX_API_KEY=
# OpenAlex budget: searches cost $0.001 (budget $1/day, resets 00:00 UTC), DOI lookups are free
OPENALEX_DAILY_SEARCHES=900
OPENALEX_RUN_SEARCHES=0
CACHE_DIR=.cache
# Retrieval: ONNX threads per call and concurrent retrievals (threads x slots <= CPUs).
# Measured in the app container: 10-core Mac -> 4 / 2 (103 s for 50 retrievals, 0.74 GB);
# 4-vCPU server -> 2 / 2 (161 s on the Mac container, not measured on a 4-vCPU machine).
RETRIEVAL_THREADS=2
RETRIEVAL_SLOTS=2
# Source PDFs: grobid (default) | fast (pypdfium2, no GROBID round trip)
SOURCE_PDF_PARSER=grobid

GROBID_URL=http://localhost:8070

# Limits
MAX_UPLOAD_MB=20
# Web jobs running at once; daily cap on accepted jobs (resets 00:00 UTC)
MAX_RUNNING_JOBS=2
MAX_JOBS_PER_DAY=300
# Token for GET /api/usage?token=... (daily report counts by country; empty = endpoint off)
USAGE_TOKEN=
MAX_REFERENCES=200
MAX_CLAIMS=150
LLM_CONCURRENCY=4
# Skeptic calls in flight (0 = same as LLM_CONCURRENCY); falls back to LLM_CONCURRENCY on HTTP 429
LLM_CONCURRENCY_SKEPTIC=0

# Deploy (docker compose / caddy)
DOMAIN=
