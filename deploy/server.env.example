# Non-secret tuning for the Vultr server (4 dedicated vCPU, 16 GB RAM). Copy to
# /opt/claimtrace/server.env. Start with BOTH env files so these also drive compose interpolation:
#   docker compose --env-file .env --env-file server.env up -d --build
# Secrets stay in .env; this file holds only sizing.

# Retrieval on CPU: ONNX threads x concurrent retrievals <= vCPUs (GROBID shares the CPUs).
RETRIEVAL_THREADS=2
RETRIEVAL_SLOTS=2

# Web jobs running at once (others queue). Memory per extra job is small (retrieval slots are
# shared), so 3 fits; raise only after watching `docker stats`.
MAX_RUNNING_JOBS=3

# Container memory caps. App: measured single-job peak 0.74 GB after the batching fix (1.39 GB
# before); 3 jobs share the retrieval slots, so <= ~1.3 GB expected -> 3 GB = ~2x headroom.
# GROBID: measured peak 4.58 GB hit the old 4.5 GB cap -> 6 GB. Total ~9 GB of 16 GB + 4 GB swap.
APP_MEM_LIMIT=3g
GROBID_MEM_LIMIT=6g
